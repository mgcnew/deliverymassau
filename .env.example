NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente no servidor. Nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push - aviso de pedido novo no celular do entregador.
# Gere um par novo com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Somente no servidor. Nunca expor no frontend.
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo VAPID (mailto: do responsavel).
VAPID_SUBJECT=

# Taxa de entrega por distancia (Configuracoes > Taxa de entrega).
# Chave do Google Maps Platform com Routes API ativada. Somente no servidor.
GOOGLE_MAPS_API_KEY=
# Opcional: maximo de chamadas ao Google em 24 h (padrao 250).
ENTREGA_LIMITE_DIA=
# Somente desenvolvimento, para testar sem chave e sem mexer no banco:
# ENTREGA_KM_FALSO=3.2          (km que o "Google" responde)
# ENTREGA_MODO_FORCADO=distancia (checkout local como se o modo estivesse ativo)
